# --- Database ---------------------------------------------------------
# PostgreSQL connection string. Locally you can run Postgres via Docker:
#   docker run --name cyg-postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
# Then: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/courtyard_grill"
# In production, use your host's connection string (Supabase, Neon, Railway, RDS, etc).
DATABASE_URL="postgresql://user:password@localhost:5432/courtyard_grill"

# --- Auth ---------------------------------------------------------------
# Random long secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# --- Seed admin account (used only by `npm run db:seed`) ---------------
SEED_ADMIN_EMAIL="admin@courtyardgrill.pk"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Email (Resend) -------------------------------------------------------
# Optional. If unset, reservation/order confirmation emails are skipped
# (logged to the console) instead of failing the request.
RESEND_API_KEY=""
EMAIL_FROM="Courtyard Grill <reservations@courtyardgrill.pk>"

# --- Image storage (optional, for future admin image uploads) ----------
# Use ONE of the following providers if you extend image uploads beyond
# pasting external image URLs in the admin menu editor.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# --- OR ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Maps -----------------------------------------------------------------
# Optional. The Contact page currently uses a keyless Google Maps embed
# (no API key required). Set this only if you swap in the JS Maps SDK.
GOOGLE_MAPS_API_KEY=""

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://courtyardgrill.pk"
